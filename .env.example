APP_NAME=BillboardBD
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail. `log` sends nothing: it renders each email into storage/logs/laravel.log
# instead, which is what you want in development - no account, no API key, and
# a stray address in seeded data can never reach a real person. The password
# reset flow works fully on it; you just read the link out of the log:
#   Select-String -Path storage/logs/laravel.log -Pattern "reset-password\?token=" | Select-Object -Last 1
#
# Switching to real delivery is env-only, no code change. Pick ONE block below,
# uncomment it, replace MAIL_MAILER=log with MAIL_MAILER=smtp, then run
# `php artisan config:clear`.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@billboardbd.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Gmail: real delivery, ~500/day, no domain needed. Requires 2-Step
# Verification on the Google account plus an App Password from
# myaccount.google.com/apppasswords - a normal Gmail password is rejected.
# MAIL_FROM_ADDRESS must be the same account, because Gmail rewrites From.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465
# MAIL_SCHEME=smtps
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=your16charapppassword
#
# Port 465 + MAIL_SCHEME=smtps is deliberate. Gmail's usual 587 (STARTTLS) is
# blocked outbound on many ISPs here - it fails as a connection TIMEOUT, not an
# auth error, which is misleading. 465 uses implicit TLS and gets through.
# Check with: Test-NetConnection -ComputerName smtp.gmail.com -Port 587
#
# --- Mailtrap: a fake inbox for testing. Mail is captured, never delivered,
# so it cannot escape to real addresses. Credentials come from your inbox page.
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=
# MAIL_PASSWORD=
#
# --- Brevo: 300/day free with real delivery, and a single sender address can
# be verified without owning a domain. Password is the generated SMTP key.
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
#
# Mailtrap and Brevo use STARTTLS, which is MAIL_SCHEME=null (as left above).
# Gmail is configured on implicit TLS instead - see the note in its block.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SSLCommerz payment gateway (client actor checkout)
SSLC_STORE_ID=
SSLC_STORE_PASSWD=
SSLC_SANDBOX=true

# Base URL of the React SPA - the browser is redirected here after checkout.
FRONTEND_URL=http://localhost:5173
